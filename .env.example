# ---- Copy to .env and edit. NEVER commit the real .env ----
# PostgreSQL (docker compose builds this URL for you; set it yourself for Neon/Render/Supabase)
DATABASE_URL=postgresql+psycopg2://truthshield:truthshield@localhost:5432/truthshield
POSTGRES_PASSWORD=truthshield

# Auth: generate a long random value, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=120

# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# DEMO_MODE=true -> everything runs locally, no external API used
DEMO_MODE=true
SEED_ON_STARTUP=true
# Optional (only used when DEMO_MODE=false): Google Fact Check Tools API key
FACT_CHECK_API_KEY=

# Decision thresholds (upper bounds, inclusive)
SAFE_MAX=30
WARNING_MAX=60
REVIEW_MAX=80
FACT_MATCH_THRESHOLD=0.35

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
RATE_LIMIT_ENABLED=true
